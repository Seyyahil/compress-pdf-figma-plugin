{
  "name": "compress-pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Figma PDF export and compression preserving vector text",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "check:distribution": "node scripts/check-distribution.mjs"
  },
  "dependencies": {
    "pako": "2.1.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.126.0",
    "esbuild": "0.25.12",
    "playwright": "1.56.1",
    "typescript": "5.9.3"
  }
}
